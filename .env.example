# ---------------------------------------------------------------------------
# TaskPulse - environment configuration
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=3000

# Where the browser reaches the API (used for CORS + cookie behavior)
CLIENT_ORIGIN=http://localhost:3000

# PostgreSQL
# When running via `docker compose up`, the compose file overrides this host
# to `db` so the API talks to the container instead of your machine.
DATABASE_URL=postgres://taskpulse:taskpulse@localhost:5432/taskpulse
PGSSL=false

# Auth - CHANGE THESE. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# OpenWeatherMap - https://home.openweathermap.org/api_keys
# Free "Current Weather" plan is enough. Leave blank to run without the
# integration: the dashboard widget renders an "unavailable" state instead.
WEATHER_API_KEY=
WEATHER_UNITS=metric
WEATHER_LANG=en
WEATHER_CACHE_TTL_MS=600000
WEATHER_TIMEOUT_MS=8000